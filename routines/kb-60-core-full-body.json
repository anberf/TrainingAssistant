{
  "id": "kb-60-core-full-body",
  "name": "KB 60 min core + full body",
  "description": "Warm-up, full-body strength circuit, core circuit, stretch.",
  "weight": "10 kg",
  "defaults": { "secPerRep": 3 },
  "blocks": [
    {
      "name": "Warm-up",
      "rounds": 2,
      "restBetweenRounds": 0,
      "steps": [
        { "name": "Halo", "type": "exercise", "clip": "clips/halo.webp", "reps": 10, "perSide": true,
          "cues": ["Bell close around head", "Ribs down, glutes tight", "Slow, smooth circles"] },
        { "name": "Pause", "type": "pause", "seconds": 15 },
        { "name": "Goblet squat", "type": "exercise", "clip": "clips/goblet-squat.webp", "reps": 10,
          "cues": ["Bell at chest, elbows in", "Sit between your heels", "Chest up, knees out"] },
        { "name": "Pause", "type": "pause", "seconds": 15 },
        { "name": "Deadlift", "type": "exercise", "clip": "clips/deadlift.webp", "reps": 10,
          "cues": ["Push hips back", "Flat back, long spine", "Stand tall, squeeze glutes"] },
        { "name": "Pause", "type": "pause", "seconds": 15 }
      ]
    },
    {
      "name": "Block A",
      "rounds": 3,
      "restBetweenRounds": 120,
      "steps": [
        { "name": "Two-hand swing", "type": "exercise", "clip": "clips/two-hand-swing.webp", "reps": 15,
          "cues": ["Hinge, don't squat", "Snap hips to stand", "Arms are ropes"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Goblet squat", "type": "exercise", "clip": "clips/goblet-squat.webp", "reps": 12,
          "cues": ["Bell at chest, elbows in", "Sit between your heels", "Drive up through feet"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Turkish get-up", "type": "exercise", "clip": "clips/turkish-get-up.webp", "reps": 3, "perSide": true, "secPerRep": 20,
          "cues": ["Eyes on the bell", "Arm locked overhead", "Slow and controlled"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Goblet reverse lunge", "type": "exercise", "clip": "clips/goblet-reverse-lunge.webp", "reps": 8, "perSide": true,
          "cues": ["Long step back", "Back knee kisses floor", "Push through front heel"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Single-arm overhead press", "type": "exercise", "clip": "clips/single-arm-overhead-press.webp", "reps": 8, "perSide": true,
          "cues": ["Squeeze glutes and core", "Press up, bicep by ear", "Lower slowly to rack"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Single-arm row", "type": "exercise", "clip": "clips/single-arm-row.webp", "reps": 10, "perSide": true,
          "cues": ["Flat back, hips hinged", "Elbow to back pocket", "No torso twist"] }
      ]
    },
    {
      "name": "Transition",
      "rounds": 1,
      "steps": [
        { "name": "Transition", "type": "pause", "seconds": 120 }
      ]
    },
    {
      "name": "Block B",
      "rounds": 3,
      "restBetweenRounds": 60,
      "steps": [
        { "name": "Russian twist", "type": "exercise", "clip": "clips/russian-twist.webp", "reps": 20,
          "cues": ["Lean back, chest proud", "Rotate from ribs", "Bell follows your eyes"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Dead bug", "type": "exercise", "clip": "clips/dead-bug.webp", "reps": 10, "perSide": true,
          "cues": ["Low back glued down", "Reach long, move slow", "Exhale as you extend"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Plank pull-through", "type": "exercise", "clip": "clips/plank-pull-through.webp", "reps": 10, "perSide": true,
          "cues": ["Hips square to floor", "Feet wide for balance", "Drag, don't swing"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Hollow hold", "type": "exercise", "clip": "clips/hollow-hold.webp", "seconds": 30,
          "cues": ["Low back pressed down", "Arms and legs long", "Breathe, stay tight"] },
        { "name": "Pause", "type": "pause", "seconds": 20 },
        { "name": "Suitcase march", "type": "exercise", "clip": "clips/suitcase-march.webp", "seconds": 30, "perSide": true,
          "cues": ["Stand tall, no lean", "Knees to hip height", "Brace your core"] }
      ]
    },
    {
      "name": "Cool-down",
      "rounds": 1,
      "steps": [
        { "name": "Leg & hip stretch", "type": "exercise", "clip": "clips/leg-hip-stretch.webp", "seconds": 300,
          "cues": ["Breathe slow and deep", "Ease in, no bouncing", "Hold each stretch 30 s"] }
      ]
    }
  ]
}
